# Kopyala: cp .env.example .env
# Demo içindir; gerçek ortamda JWT_SECRET ve POSTGRES_PASSWORD değiştirilmeli.

POSTGRES_USER=pist
POSTGRES_PASSWORD=pist-demo-parola
POSTGRES_DB=pistkoordinat

# En az 32 karakter. Üretmek için: openssl rand -base64 48
JWT_SECRET=degistir-bunu-en-az-otuz-iki-karakterlik-gizli-anahtar

# Deterministik veri: aynı SEED + aynı SEED_DATE aynı çizelgeyi üretir.
# SEED_DATE boşsa havalimanı saatine göre bugün kullanılır.
SEED=42
SEED_DATE=
AIRPORT_TZ=Europe/Istanbul

# Simülatörün besleme partisi aralığı
SIM_INTERVAL=3s

# T-5 doğrulamasında hedeflenen görev olayı sayısı
VERIFY_EVENTS=5000000

LOG_LEVEL=info
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
